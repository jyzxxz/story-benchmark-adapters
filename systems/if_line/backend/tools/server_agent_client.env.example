# 服务端 Agent 假前端控制台配置示例。
# 使用时复制为 backend/tools/server_agent_client.env，或直接通过命令行参数覆盖。

IFLINE_AGENT_BASE_URL=http://127.0.0.1:60002
IFLINE_AGENT_EMAIL=
IFLINE_AGENT_PASSWORD=
IFLINE_AGENT_GUEST=false

# 启动时是否自动恢复当前用户最近的 thread。
IFLINE_AGENT_RESUME=false
IFLINE_AGENT_RESUME_STATUS=
IFLINE_AGENT_RESUME_AGENT_KIND=server_agent
IFLINE_AGENT_RESUME_LIMIT=20

# 也可以直接固定某个 thread。
IFLINE_AGENT_THREAD_ID=
IFLINE_AGENT_KIND=server_agent
IFLINE_AGENT_MODE=

# 假前端 VNGraph 工作区上下文。
IFLINE_AGENT_PROJECT_ID=
IFLINE_AGENT_CHAPTER_INDEX=
IFLINE_AGENT_VNGRAPH_REVISION_ID=
IFLINE_AGENT_NODE_INDEX=
IFLINE_AGENT_VNGRAPH_FILE=
IFLINE_AGENT_VNGRAPH_TOOL_PROJECT=
IFLINE_AGENT_SAVE_VNGRAPH_ON_PATCH=false

# 调试参数。默认不打印事件，详细过程去 Phoenix 看。
IFLINE_AGENT_TIMEOUT_SECONDS=180
IFLINE_AGENT_POLL_INTERVAL_SECONDS=0.4
IFLINE_AGENT_TRACE_EVENTS=false
