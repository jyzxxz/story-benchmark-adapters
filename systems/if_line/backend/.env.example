# 环境变量配置文件

# 运行环境：development / test / staging / production
# production 会拒绝 SQLite、通配 CORS、非 Secure Cookie 和占位供应商密钥。
APP_ENV=development
DEBUG=false

# 数据库配置
DATABASE_URL=sqlite:///./novel_agent.db
# 连接池：每进程最多 POOL_SIZE+OVERFLOW 个 PG 连接。
# 进程数 = 生图组(CELERY_CONCURRENCY) + 文本组(TEXT_WORKER_CONCURRENCY) + 1 个 FastAPI。
# 8+8 配 5+4 分组最坏 10×16=160 ≤ PG max_connections(200)，留余量。
# 调整任一并发后务必重算：进程数 × (POOL_SIZE+OVERFLOW) ≤ max_connections。
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=8
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
CHECK_DEPENDENCIES_ON_STARTUP=false

# PostgreSQL 生产示例（不要把真实密码提交到版本库）
# DATABASE_URL=postgresql+psycopg://if_line:change-me@127.0.0.1:5432/if_line

# Redis / Celery（持久任务批次启用后使用）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
TASK_LEASE_SECONDS=180
TASK_DEPENDENCY_POLL_SECONDS=5
TASK_DEPENDENCY_MAX_RETRIES=360
TASK_EVENT_POLL_SECONDS=1
OUTBOX_BATCH_SIZE=50

# LLM 配置
# Key 池用逗号或换行分隔；未配置时继续使用兼容项 OPENAI_API_KEY。
# 两者同时配置时，单 Key 会作为去重后的池成员补充。
OPENAI_API_KEYS=
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 分析器专用文本模型池（背景场景/立绘需求/插画时刻/配音切片/AI 味检查）。
# 未配置时继承 OPENAI_* 配置；可单独指定 key/URL/模型。
# 默认与主模型同为 flash：分析任务输出短、走结构化 JSON，用 pro 会显著放大 token 消耗。
# 个别分析器可独立覆盖：PORTRAIT_DEMAND_MODEL / KEYFRAME_MOMENT_MODEL /
# CHAPTER_VOICE_MODEL / AI_FLAVOR_MODEL（均回落到 BG_ANALYZER_MODEL）。
BG_ANALYZER_API_KEYS=
BG_ANALYZER_API_KEY=your-analyzer-api-key-here
BG_ANALYZER_BASE_URL=https://api.deepseek.com
BG_ANALYZER_MODEL=deepseek-v4-flash

# 服务器配置
HOST=0.0.0.0
PORT=60002
WORKERS=1
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false
AUTH_RATELIMIT_BACKEND=memory
AUTH_RATELIMIT_REDIS_URL=redis://127.0.0.1:6379/1
AUTH_RATELIMIT_WINDOW_SECONDS=60
AUTH_RATELIMIT_MAX_FAILURES=10
AUTH_LAST_SEEN_WRITE_INTERVAL_SECONDS=300
AUTH_TRUSTED_PROXY_IPS=127.0.0.1,::1
SECURITY_HSTS_ENABLED=false
METRICS_ENABLED=true
# 生产环境必须设置；使用 Authorization: Bearer <token> 读取 /metrics。
METRICS_TOKEN=replace-me-with-a-long-random-token

# OpenTelemetry 统一观测入口。留空表示不导出。
# 后端、worker、Agent trace/log 都打到本地 OTel Collector，由 Collector 分发:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14318
OTEL_SERVICE_NAME=if-line-backend
OTEL_SERVICE_NAMESPACE=if-line
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10
OTEL_EXPORTER_OTLP_TRUST_ENV=false

# Agent trace 会使用独立 service.name，Collector 根据该值路由到 Phoenix。
AGENT_TRACE_SERVICE_NAME=if-line-agent

# 加法式迁移功能开关
AIVN_REMOTE_ASSET_SOURCES_ENABLED=true
AGENT_COMPOSE_ENABLED=true
BRANCHING_ENABLED=true
MEDIA_GATEWAY_ENABLED=true
REVISION_READ_ENABLED=true
TASK_SYSTEM_ENABLED=true
VISUAL_ASSET_ACTIONS_ENABLED=true
READER_DYNAMIC_CONTINUATION_ENABLED=true
CELERY_LOG_LEVEL=WARNING
VISUAL_ASSET_CATALOG_VERSION=v1.1_combined
VISUAL_ASSET_MATCHER_VERSION=hash-ngram-v1
VISUAL_ASSET_UPLOAD_MAX_BYTES=26214400
LEGACY_SYNC_API_ENABLED=true

# 本地 AIVN 编辑器联调绕过登录；生产环境必须保持 false
AIVN_DEV_AUTH_BYPASS=false
AIVN_DEV_AUTH_EMAIL=dev@ifline.local
AIVN_DEV_AUTH_NAME=AIVN Dev

# TTS 配置。生产环境启用后会在启动时校验所选 provider 的全部凭据。
# 支持 aliyun、minimax、xunfei；其他 TTS_ENGINE 会拒绝启动。
TTS_ENABLED=false
TTS_ENGINE=minimax

# TTS 兜底开关（主供应商失败且重试耗尽后，是否允许切到 fallback 引擎）
# - false（默认）：主供应商失败即失败，行为与历史一致
# - true：主供应商返回可兜底错误（超时/网络/429/5xx/音色无效/空音频）时，
#         切到 TTS_FALLBACK_ENGINE 再合成一次。章节配音仅在重试耗尽后触发，
#         不会形成 主→fallback→主 的循环。
# 生产环境若设 true，MINIMAX_TTS_API_KEY 必须为非占位符真实 Key（启动时校验）。
TTS_FALLBACK_ENABLED=false
# 当前仅支持 minimax；生产环境配置其他值会拒绝启动。
TTS_FALLBACK_ENGINE=minimax

# 阿里云百炼 API Key
# 控制台：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxx

# 阿里云百炼非实时 TTS Endpoint
# 推荐配置 ALIYUN_TTS_WORKSPACE_ID 使用专属域名；不配置时走兼容域名。
ALIYUN_TTS_REGION=cn-beijing
ALIYUN_TTS_WORKSPACE_ID=
ALIYUN_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_TTS_COSYVOICE_MODEL=cosyvoice-v3-flash
ALIYUN_TTS_QWEN_MODEL=qwen3-tts-flash
ALIYUN_TTS_AUDIO_FORMAT=mp3
ALIYUN_TTS_QWEN_AUDIO_FORMAT=wav
ALIYUN_TTS_SAMPLE_RATE=24000
ALIYUN_TTS_TIMEOUT=60
ALIYUN_TTS_CONNECT_TIMEOUT=10
ALIYUN_TTS_LANGUAGE_TYPE=Chinese
ALIYUN_TTS_ENABLE_SSML=false

# TTS 缓存与默认音色
TTS_OUTPUT_DIR=static/tts_cache
TTS_AUDIO_BASE_URL=/static/tts_cache
TTS_DEFAULT_SPEAKER=male-qn-qingse
TTS_MAX_TEXT_LENGTH=600
TTS_AUDIO_FORMAT=mp3
TTS_ALLOWED_SPEAKERS=male-qn-qingse,female-shaonv,male-qn-jingying,female-yujie

# Voice Clone 上传和单次合成限制。参考音频只能通过受控媒体网关读取。
VOICE_CLONE_MAX_UPLOAD_BYTES=20971520
VOICE_CLONE_MAX_TTS_CHARS=600

# 讯飞开放平台凭据（仅 TTS_ENGINE=xunfei 时使用）
# 控制台：https://www.xfyun.cn/  →  超拟人语音合成  →  应用管理
XUNFEI_TTS_APPID=***
XUNFEI_TTS_API_KEY=***
XUNFEI_TTS_API_SECRET=***

# 讯飞 WS 接入点（默认为超拟人域名，如控制台给出不同地址请覆盖）
XUNFEI_TTS_DOMAIN=cbm01.cn-huabei-1.xf-yun.com
XUNFEI_TTS_PATH=/v1/private/mcd9m97e6
# 超拟人在 parameter 下的子 key（不同版本可能叫 ora12 / tts / sds）
XUNFEI_TTS_PARAM_KEY=ora12

# 音频与合成参数
XUNFEI_TTS_AUE=lame
XUNFEI_TTS_AUF=audio/L16;rate=16000
XUNFEI_TTS_SPEED=50
XUNFEI_TTS_VOLUME=50
XUNFEI_TTS_PITCH=50
XUNFEI_TTS_TIMEOUT=30
XUNFEI_TTS_WS_CONNECT_TIMEOUT=10

# ========== MiniMax 同步语音合成（默认主渠道，也可作为其他引擎的兜底） ==========
# TTS_ENGINE=minimax 时直接使用；其他主引擎也可通过 fallback 或 force_engine 使用。
# 控制台：https://platform.minimaxi.com/  →  对话与语音  →  语音合成 T2A v2
#
# 【安全】不要把真实 Key 提交到版本库。生产环境启用 MiniMax 主引擎或 fallback 时，
#         Key 若为空或为占位符（sk-xxx / your-api-key / placeholder 等），启动会失败。
MINIMAX_TTS_API_KEY=

# 使用官方通用接入点；传输超时/网络失败时自动切到官方北京备用域名。
# 收到 HTTP/业务响应后不会切端点重提，避免明确业务错误造成重复计费。
MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TTS_BACKUP_BASE_URL=https://api-bj.minimaxi.com/v1
MINIMAX_TTS_MODEL=speech-2.8-hd

# 超时（秒）。connect_timeout 偏短便于快速判定为「网络异常」并触发兜底。
MINIMAX_TTS_TIMEOUT=60
MINIMAX_TTS_CONNECT_TIMEOUT=20

# 音频参数（独立于阿里云/讯飞，按 MiniMax 支持的范围设置）
MINIMAX_TTS_AUDIO_FORMAT=mp3
MINIMAX_TTS_SAMPLE_RATE=32000
MINIMAX_TTS_BITRATE=128000
MINIMAX_TTS_CHANNEL=1
# 中文语种增强；英文/多语场景可设 English / NoBoost
MINIMAX_TTS_LANGUAGE_BOOST=Chinese

# 默认 voice_id（兜底的兜底：profile 既无 fallback_voice_ids.minimax、
# 又没有 voice_map 命中时用此 ID）。
# 官方示例值：male-qn-qingse / female-shaonv / male-qn-jingying / female-yujie
MINIMAX_TTS_DEFAULT_VOICE_ID=male-qn-qingse

# 主供应商音色 → MiniMax voice_id 映射。
# ⚠️ 永远不要把阿里云/讯飞 VCN（如 longshuo_v3 / x6_lingfeiyi_pro）写进这里，
#    MiniMax 不识别这些 ID 会退回 default；同时会造成缓存键错乱。
#    只填 MiniMax 自己的 voice_id。
# JSON 格式，主 key 是「角色主音色字符串」，value 是 MiniMax voice_id。
MINIMAX_TTS_VOICE_MAP_JSON={}

# ========== 图像生成配置 ==========

# 功能开关
IMAGE_GENERATION_ENABLED=true

# Qwen-Image / 兼容 OpenAI 协议的图像 API 配置
# 图片池只在服务端使用，绝不接收前端文本模型 BYOK。
AI_IMAGE_API_KEYS=
AI_IMAGE_API_KEY=your-image-api-key-here
# 兼容网关示例；直连百炼时用
# https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
AI_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_PROMPT_EXTEND=true
AI_IMAGE_WATERMARK=false

# 可选：背景视觉验收使用独立池。该池只由服务端使用，不接受文本 BYOK。
BG_VISION_API_KEYS=
# BG_VISION_API_KEY=
# BG_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 必须选择当前网关实际支持图像输入的模型。
BG_VISION_MODEL=gpt-5.4-mini

# 立绘年龄视觉验收：生成后由 VLM 判断画面中的表观年龄是否符合年龄契约。
PORTRAIT_AGE_VALIDATE_ENABLED=true
PORTRAIT_AGE_VALIDATE_STRICT=true
PORTRAIT_AGE_VALIDATE_TIMEOUT=30
PORTRAIT_AGE_VALIDATE_MIN_CONFIDENCE=0.65
PORTRAIT_AGE_VALIDATE_MAX_RETRIES=1
PORTRAIT_REWRITER_MAX_REPAIRS=2

# 可选文本增强开关
# 开启后默认继承 OPENAI_API_KEY / OPENAI_BASE_URL / LLM_MODEL。
# AI_IMAGE_* 只用于 Qwen-Image 图片生成，不应优先参与文本增强调用。
PORTRAIT_AUTO_DEMAND=1
PORTRAIT_DEMAND_ENABLED=true
PROMPT_REWRITER_ENABLED=true
REWRITER_TIMEOUT=20
# 官方角色识别：deepseek-v4-flash 结构化输出实测 7-14s，12s 默认会掐死调用
CANONICAL_CHARACTER_RECOGNITION_TIMEOUT=120
BG_ANALYZER_ENABLED=true
BG_STYLE_CLASSIFIER_ENABLED=true
SCENE_SEGMENTER_ENABLED=true
KEYFRAME_AUTO_SELECT=1
KEYFRAME_MOMENT_ENABLED=true
# 身份验收失败默认直接走本地 sprite composite；可设 1 允许一次额外付费重试。
KEYFRAME_IDENTITY_MAX_RETRIES=0

# 存储配置（开发环境）
IMAGE_OUTPUT_DIR=static/assets
IMAGE_BASE_URL=/static/assets

# 生产环境配置示例
# IMAGE_OUTPUT_DIR=/mnt/oss/assets
# IMAGE_BASE_URL=https://cdn.yourdomain.com/assets

# --- 并行化开关（默认 false = 串行，行为不变；设 true 启用任务内并发）---
# 配合 DATABASE_POOL_SIZE/MAX_OVERFLOW 使用（见顶部连接池注释）。
# --- 任务级并发（分队列部署，见 start_worker_image.sh / start_worker_text.sh）---
# 调大时注意：
# 1) 总 PG 连接 = (CELERY_CONCURRENCY + TEXT_WORKER_CONCURRENCY + 1) × (DATABASE_POOL_SIZE+DATABASE_MAX_OVERFLOW) ≤ max_connections
# 2) 总生图并发 = CELERY_CONCURRENCY × IMAGE_CONCURRENCY 不得超出图片供应商单 Key 并发上限
#    （start_worker_image.sh 启动时会校验并拒绝超限启动）
# 生图组 worker 进程数（start_worker_image.sh，消费 image 队列）
# CELERY_CONCURRENCY=5
# 文本/语音/编译组 worker 进程数（start_worker_text.sh）
# TEXT_WORKER_CONCURRENCY=4
# 每进程内部对生图 API 的并发上限（进程级信号量，多 worker 会叠加）
# IMAGE_CONCURRENCY=2
# H2: 立绘批量生成两段式
PARALLEL_PORTRAIT_GENERATION=false
# H3/H5: 背景批量生成两段式（含 v2）
PARALLEL_BACKGROUND_GENERATION=false
# H4: 关键帧批量生成两段式
PARALLEL_KEYFRAME_GENERATION=false
# PG 部署后可开启的素材分支并行
PARALLEL_ASSET_BRANCHES=false
