{
  "method": "post",
  "path": "/api/path-chapters/{path_chapter_id}/revisions",
  "operation": {
    "summary": "手动保存章节正文版本",
    "deprecated": false,
    "description": "手动保存一版章节正文。该接口只创建 revision，不会自动设置为当前章节正文。",
    "operationId": "add_chapter_revision_api_projects__project_id__chapters__chapter_index__revisions_post",
    "tags": [
      "创作版本与生成/章节生成",
      "创作版本与生成"
    ],
    "parameters": [
      {
        "in": "path",
        "name": "path_chapter_id",
        "required": true,
        "schema": {
          "title": "Path Chapter Id",
          "type": "string"
        },
        "description": "路径章节编号。它表示某条 story path 里的一个章节位置，不等同于旧接口的 chapter_index。"
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ChapterRevisionCreate"
          },
          "example": {
            "content": "2027年，中关村的夜晚灯火通明。牢梁坐在创业咖啡馆角落里，盯着屏幕上的代码，准备挑战Codex。",
            "parent_revision_id": null
          }
        }
      },
      "required": true,
      "description": "章节正文修订内容。content 是完整正文文本；parent_revision_id 表示基于哪一版修改。"
    },
    "responses": {
