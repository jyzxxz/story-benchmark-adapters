{
  "method": "post",
  "path": "/api/projects/{project_id}/story-paths",
  "operation": {
    "operationId": "createStoryPathFromCandidate",
    "parameters": [
      {
        "in": "path",
        "name": "project_id",
        "required": true,
        "schema": {
          "title": "Project Id",
          "type": "integer"
        },
        "description": "项目编号。"
      },
      {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Idempotency-Key",
          "type": "string"
        },
        "description": "幂等键。一次用户操作生成一个稳定字符串；同一用户用同一个 key 重试同一请求会返回同一任务，换请求内容会返回冲突。"
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/StoryPathCreate"
          }
        }
      },
      "required": true,
      "description": "创建故事路径请求。candidate_id 必填，title 可选。"
    },
    "responses": {
      "201": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StoryPath"
            }
          }
        },
        "description": "Successful Response"
      },
      "422": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HTTPValidationError"
            }
          }
        },
        "description": "Validation Error"
      }
    },
    "security": [
      {
        "cookieAuth": []
      }
    ],
    "summary": "从候选创建故事路径",
    "tags": [
      "分支生成"
    ],
    "x-apifox-folder": "创作版本与生成/故事路径",
    "x-apifox-status": "released",
    "description": "把某个 BranchCandidate 提升为新的 story path。需要 Idempotency-Key 防止重复创建分支。"
  }
}
