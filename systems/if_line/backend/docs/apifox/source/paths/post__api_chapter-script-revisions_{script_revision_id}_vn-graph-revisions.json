{
  "method": "post",
  "path": "/api/chapter-script-revisions/{script_revision_id}/vn-graph-revisions",
  "operation": {
    "summary": "手动创建 VNGraph 修订（草稿物化）",
    "description": "把客户端编辑的 VNGraph 草稿固化为不可变修订。内容寻址去重幂等，不激活 head。需通过图校验；同脚本已存在编译绑定且草稿内容不一致时返回 409（改图走 VNGraph patch）。",
    "operationId": "createVNGraphRevision",
    "tags": [
      "创作版本与生成/视觉小说图步骤二：最终产物生成",
      "视觉小说图步骤二：最终产物生成"
    ],
    "x-apifox-folder": "创作版本与生成/视觉小说图步骤二：最终产物生成",
    "parameters": [
      {
        "in": "path",
        "name": "script_revision_id",
        "required": true,
        "schema": {
          "title": "Script Revision Id",
          "type": "string"
        },
        "description": "锚定的章节脚本修订 UUID。"
      },
      {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Idempotency-Key",
          "type": "string"
        },
        "description": "幂等键。一次用户操作生成一个稳定字符串；同一用户用同一个 key 重试同一请求会返回同一任务，换请求内容会返回冲突。"
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VNGraphRevisionCreate"
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "创建成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VNGraphRevision"
            }
          }
        },
        "headers": {},
        "x-apifox-name": "成功",
        "x-apifox-ordering": 0
      },
      "409": {
        "description": "该脚本的图已被编译绑定且草稿内容不一致",
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
          }
        },
        "x-apifox-name": "校验失败",
        "x-apifox-ordering": 1
      },
      "422": {
        "description": "请求非法（校验失败，具体原因见 message）",
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
          }
        },
        "x-apifox-name": "校验失败",
        "x-apifox-ordering": 1
      }
    }
  }
}
