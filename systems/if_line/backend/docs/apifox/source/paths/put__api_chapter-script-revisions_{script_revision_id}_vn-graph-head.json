{
  "method": "put",
  "path": "/api/chapter-script-revisions/{script_revision_id}/vn-graph-head",
  "operation": {
    "operationId": "updateVNGraphHead",
    "parameters": [
      {
        "in": "path",
        "name": "script_revision_id",
        "required": true,
        "schema": {
          "title": "Script Revision Id",
          "type": "string"
        },
        "description": "章节脚本修订编号。"
      },
      {
        "in": "header",
        "name": "If-Match",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "If-Match"
        },
        "description": "乐观锁版本，填 GET head 或 GET 资源详情响应头里的 ETag，例如 \"2\"；不传时后端不做版本冲突保护。"
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HeadUpdate"
          },
          "example": {
            "revision_id": "00000000-0000-0000-0000-000000000000"
          }
        }
      },
      "required": true,
      "description": "传入要设为当前 VNGraph 的 revision_id。"
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RevisionHead"
            }
          }
        },
        "description": "Successful Response"
      },
      "422": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HTTPValidationError"
            }
          }
        },
        "description": "Validation Error"
      }
    },
    "security": [
      {
        "cookieAuth": []
      }
    ],
    "summary": "设置当前 VNGraph 版本",
    "tags": [
      "创作版本与生成/视觉小说图步骤二：最终产物生成",
      "视觉小说图"
    ],
    "x-apifox-folder": "创作版本与生成/视觉小说图步骤二：最终产物生成",
    "x-apifox-status": "released",
    "description": "设置当前采用的修订版本。\n\n接口语义：\n- 这是“审核/选择当前版本”\n- 不会新建内容\n- 不会重新生成内容\n\n并发控制：\n- 建议先 GET 对应 head\n- 读取响应头 `ETag` 或响应体 `lock_version`\n- PUT 时通过 `If-Match` 带回，避免覆盖别人刚刚切换的版本"
  }
}
