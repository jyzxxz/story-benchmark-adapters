{
  "method": "put",
  "path": "/api/path-chapters/{path_chapter_id}/head",
  "operation": {
    "operationId": "updateChapterHead",
    "parameters": [
      {
        "in": "path",
        "name": "path_chapter_id",
        "required": true,
        "schema": {
          "title": "Path Chapter Id",
          "type": "string"
        },
        "description": "路径章节编号。它表示某条 story path 里的一个章节位置，不等同于旧接口的 chapter_index。"
      },
      {
        "in": "header",
        "name": "If-Match",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "If-Match"
        },
        "description": "乐观锁版本，填 GET head 或 GET 资源详情响应头里的 ETag，例如 \"2\"；不传时后端不做版本冲突保护。"
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HeadUpdate"
          },
          "example": {
            "revision_id": "e959dbf6-35dc-4be0-bff9-dbd1d52dc497"
          }
        }
      },
      "required": true,
      "description": "传入要设为当前章节正文的 revision_id。"
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RevisionHead"
            },
            "example": {
              "revision_id": "e959dbf6-35dc-4be0-bff9-dbd1d52dc497",
              "lock_version": 2,
              "updated_at": "2026-08-09T15:28:31.805214Z"
            }
          }
        },
        "description": "Successful Response"
      },
      "422": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HTTPValidationError"
            }
          }
        },
        "description": "Validation Error"
      }
    },
    "security": [
      {
        "cookieAuth": []
      }
    ],
    "summary": "设置当前章节正文版本",
    "tags": [
      "创作版本与生成/章节生成",
      "创作版本与生成"
    ],
    "x-apifox-folder": "创作版本与生成/章节生成",
    "x-apifox-status": "released",
    "description": "设置当前采用的修订版本。\n\n接口语义：\n- 这是“审核/选择当前版本”\n- 不会新建内容\n- 不会重新生成内容\n\n并发控制：\n- 建议先 GET 对应 head\n- 读取响应头 `ETag` 或响应体 `lock_version`\n- PUT 时通过 `If-Match` 带回，避免覆盖别人刚刚切换的版本"
  }
}
