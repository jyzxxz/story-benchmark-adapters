{
  "name": "VisualAssetUploadRead",
  "schema": {
    "properties": {
      "action_id": {
        "title": "操作编号",
        "type": "string",
        "description": "操作编号，用于关联对应数据。"
      },
      "asset_id": {
        "title": "素材编号",
        "type": "integer",
        "description": "素材编号，用于关联对应数据。"
      },
      "asset_type": {
        "enum": [
          "portrait",
          "background",
          "keyframe"
        ],
        "title": "素材类型",
        "type": "string",
        "description": "素材类型，可选值：portrait、background、keyframe。"
      },
      "asset_version_id": {
        "title": "素材版本编号",
        "type": "string",
        "description": "素材版本编号，用于关联对应数据。"
      },
      "has_alpha": {
        "title": "是否包含透明通道",
        "type": "boolean",
        "description": "是否包含透明通道。"
      },
      "height": {
        "title": "高度",
        "type": "integer",
        "description": "高度。"
      },
      "media_type": {
        "title": "媒体类型",
        "type": "string",
        "description": "媒体类型。"
      },
      "media_url": {
        "title": "媒体地址",
        "type": "string",
        "description": "媒体地址，由服务端返回给客户端访问。"
      },
      "origin": {
        "default": "upload",
        "title": "来源",
        "description": "来源，可选值：upload。"
      },
      "ownership_scope": {
        "enum": [
          "session",
          "personal",
          "project"
        ],
        "title": "归属范围",
        "type": "string",
        "description": "归属范围，可选值：session、personal、project。"
      },
      "reused_storage_object": {
        "default": false,
        "title": "是否复用存储对象",
        "type": "boolean",
        "description": "是否复用存储对象。"
      },
      "selection_method": {
        "default": "manual_upload",
        "title": "选择方式",
        "description": "选择方式，可选值：manual_upload。"
      },
      "sha256": {
        "title": "文件哈希",
        "type": "string",
        "description": "文件哈希。"
      },
      "status": {
        "title": "状态",
        "type": "string",
        "description": "状态。"
      },
      "storage_object_id": {
        "title": "存储对象编号",
        "type": "string",
        "description": "存储对象编号，用于关联对应数据。"
      },
      "target_name": {
        "title": "目标名称",
        "type": "string",
        "description": "目标名称。"
      },
      "width": {
        "title": "宽度",
        "type": "integer",
        "description": "宽度。"
      }
    },
    "required": [
      "action_id",
      "asset_id",
      "asset_version_id",
      "storage_object_id",
      "asset_type",
      "target_name",
      "ownership_scope",
      "media_url",
      "media_type",
      "sha256",
      "width",
      "height",
      "has_alpha",
      "status"
    ],
    "title": "视觉素材上传结果",
    "type": "object",
    "x-apifox-orders": [
      "action_id",
      "asset_id",
      "asset_type",
      "asset_version_id",
      "has_alpha",
      "height",
      "media_type",
      "media_url",
      "origin",
      "ownership_scope",
      "reused_storage_object",
      "selection_method",
      "sha256",
      "status",
      "storage_object_id",
      "target_name",
      "width"
    ],
    "description": "视觉素材上传结果数据模型。",
    "x-apifox-ignore-properties": [],
    "x-apifox-folder": ""
  }
}
