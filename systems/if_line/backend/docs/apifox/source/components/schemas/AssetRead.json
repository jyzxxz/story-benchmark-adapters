        "nullable": true
      },
      "id": {
        "title": "编号",
        "type": "integer",
        "description": "编号，用于关联对应数据。"
      },
      "latest_version_id": {
        "title": "最新版本编号",
        "type": "string",
        "description": "最新版本编号，用于关联对应数据。",
        "nullable": true
      },
