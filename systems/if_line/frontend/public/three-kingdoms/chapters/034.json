,"Comment":"《三国演义》第34回，第33段","NodeType":1,"SubType":2,"X":12640,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"跃去龙驹能救主，追来虎将想要诛仇。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[43]}},{"Index":43,"DisplayName":"正文 034","Comment":"《三国演义》第34回，第34段","NodeType":1,"SubType":2,"X":13010,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"未知蔡瑁性命如何，请看下一回。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{}}]}