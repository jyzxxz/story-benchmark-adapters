"正文 020","Comment":"《三国演义》第5回，第20段","NodeType":1,"SubType":2,"X":7830,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"第十五镇，上党太守张杨。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[30]}},{"Index":30,"DisplayName":"正文 021","Comment":"《三国演义》第5回，第21段","NodeType":1,"SubType":2,"X":8200,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"第十六镇，乌程侯长沙太守孙坚。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[31]}},{"Index":31,"DisplayName":"正文 022","Comment":"《三国演义》第5回，第22段","NodeType":1,"SubType":2,"X":8570,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"第十七镇，祁乡侯渤海太守袁绍。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[32]}},{"Index":32,"DisplayName":"正文 023","Comment":"《三国演义》第5回，第23段","NodeType":1,"SubType":2,"X":8940,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"诸路军马，多少不等，有三万者，有一二万者，各领文官武将，投洛阳来。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{}}]}