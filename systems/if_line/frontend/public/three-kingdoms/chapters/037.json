{"Version":1,"StartNodeIndex":1,"Nodes":[{"Index":1,"DisplayName":"开始","Comment":"《三国演义》第37回公开阅读入口","NodeType":1,"SubType":6,"X":80,"Y":120,"Data":{},"Outputs":{"Next":[2]}},{"Index":2,"DisplayName":"章回转场","Comment":"按 VNNodeLibrary.txt 的 TransitionNode 序列化","NodeType":1,"SubType":4,"X":430,"Y":120,"Data":{"TransitionType":{"Kind":"Enum","StringValue":"FadeIn"},"BackgroundImage":{"Kind":"String","StringValue":""},"Color":{"Kind":"Color","X":0,"Y":0,"Z":0,"W":1},"Duration":{"Kind":"Float","NumberValue":0.45}},"Outputs":{"Next":[10]}},{"Index":10,"DisplayName":"正文 001","Comment":"《三国演义》第37回，第1段","NodeType":1,"SubType":2,"X":800,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说徐庶趱程赴许昌。曹操知徐庶已到，于是命荀彧、程昱等一班谋士往迎接他。庶入相府，拜见曹操。操说：“公乃高明之士，为什么屈身而事刘备吗？”庶说：“某幼逃难，流落江湖，偶至新野，于是与玄德交厚。老母在此，幸蒙慈念，不胜愧感。”操说：“公今至此，正可晨昏侍奉令堂，我亦得听清诲了。”庶行礼道谢而出。急往见他的母亲，泣拜于堂下。母非常吃惊说：“你为什么至此？”庶说：“近于新野事刘豫州，因得母书，所以连夜至此。”"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[11]}},{"Index":11,"DisplayName":"正文 002","Comment":"《三国演义》第37回，第2段","NodeType":1,"SubType":2,"X":1170,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"徐母勃然非常生气，拍案骂说：“辱子飘荡江湖数年，我认为你学业有进，何其反不如初！你既读书，须知忠孝不能两全。难道不识曹操欺君罔上之贼？刘玄德仁爱和道义布于四海，况又汉朝皇室之冑，你既事之，得他的主人了。今凭一纸伪书，更不详察，于是弃明投暗，自取恶名，真愚夫！我有何面目与你相见？你玷辱祖宗，空出生在天地间罢了！”骂得徐庶跪下行礼于地，不敢仰视，母自转入屏风后去了。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[12]}},{"Index":12,"DisplayName":"正文 003","Comment":"《三国演义》第37回，第3段","NodeType":1,"SubType":2,"X":1540,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"过了一会儿，家人出报告说：“我人上吊自杀于梁间。”徐庶慌入救时，母气已绝。后人有《徐母赞》说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[13]}},{"Index":13,"DisplayName":"正文 004","Comment":"《三国演义》第37回，第4段","NodeType":1,"SubType":2,"X":1910,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"贤哉徐母，流芳千古。守节无亏，于家有补。教子多方，处身自苦。气若丘山，义出肺腑。赞美豫州，毁触魏武。不畏鼎镬，不惧刀斧。唯恐后嗣，玷辱先祖。伏剑同流，断机堪伍。生得他的名声，死得其所。贤哉徐母，流芳千古！"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[14]}},{"Index":14,"DisplayName":"正文 005","Comment":"《三国演义》第37回，第5段","NodeType":1,"SubType":2,"X":2280,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"徐庶见母已死，哭绝于地，过了很久方苏。曹操使人赍礼吊问，又亲往祭奠。徐庶葬母柩于许昌之南原，居丧守墓。凡操有所赐，庶都不受。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[15]}},{"Index":15,"DisplayName":"正文 006","Comment":"《三国演义》第37回，第6段","NodeType":1,"SubType":2,"X":2650,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"时操想要商量南征。荀彧劝谏说：“天寒还不能用兵，姑待春暖，才能长驱大进。”操听从了他的意见，于是率领漳河之水作一池，名玄武池，于内教练水军，准备南征。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[16]}},{"Index":16,"DisplayName":"正文 007","Comment":"《三国演义》第37回，第7段","NodeType":1,"SubType":2,"X":3020,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说玄德正安排礼物，想要往隆中谒诸葛亮。忽有人报告：“门外有一先生，峨冠博带，道貌非常，特来相探。”玄德说：“此难道即孔明否？”于是整衣出迎。仔细一看，原来是司马徽。玄德非常高兴，请入后堂高坐，拜问道：“备自别仙颜，因军务倥偬，有失拜访。今得光降，大慰仰慕之私。”徽说：“闻徐元直在此，特来一会。”玄德说：“近因曹操囚他的母亲，徐母派人快马送信，唤回许昌去了。”徽说：“此中曹操之计了！我一向听说徐母最贤，虽被操囚，必不肯快马送信召他的儿子，这就是书必诈。元直不去，他的母亲尚存；今若去，母必死了！”玄德惊问他的缘故，徽说：“徐母高义，必羞见他的儿子。”玄德说：“元直临行，荐南阳诸葛亮，他的人怎么样？”徽笑着说：“元直想要去，自去就是了，何又惹他出来呕心血？”玄德说：“先生何出这句话？”徽说：“孔明与博陵崔州平、颍川石广元、汝南孟公威与徐元直四人为密友。此四人务于精纯，惟孔明独观其大略。尝抱膝长吟而指四人说：‘公等仕进，可至刺史、郡守。’众问孔明之志怎么样，孔明但笑而不答。每常自比管仲、乐毅，其才不可量。”玄德说：“何颍川之多贤吗！”徽说：“昔有殷馗善观天文，尝谓群星聚于颍分，他的地方必多贤士。”时云长在侧说：“我闻管仲、乐毅乃春秋、战国名人，功盖寰宇。孔明自比此二人，不要乃太过？”徽笑着说：“以我看了看，不当比此二人，我想要另以二人比之。”云长问：“那二人？”徽说：“可比兴周八百年之姜子牙，旺汉四百年之张子房。”众人都很惊愕。徽下阶相辞想要行，玄德留下他不住。徽出门，仰天大笑着说：“卧龙虽得他的主人，不得其时，惜呢！”言罢，飘然而去。玄德叹息说：“真隐居贤士！”"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[17]}},{"Index":17,"DisplayName":"正文 008","Comment":"《三国演义》第37回，第8段","NodeType":1,"SubType":2,"X":3390,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"第二天，玄德同关、张并从人等来隆中。遥望山畔数人，荷锄耕于田间而作歌说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[18]}},{"Index":18,"DisplayName":"正文 009","Comment":"《三国演义》第37回，第9段","NodeType":1,"SubType":2,"X":3760,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"苍天如圆盖，陆地似棋局。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[19]}},{"Index":19,"DisplayName":"正文 010","Comment":"《三国演义》第37回，第10段","NodeType":1,"SubType":2,"X":4130,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"世人黑白分，往来争荣辱。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[20]}},{"Index":20,"DisplayName":"正文 011","Comment":"《三国演义》第37回，第11段","NodeType":1,"SubType":2,"X":4500,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"荣者自安安，辱者定碌碌。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[21]}},{"Index":21,"DisplayName":"正文 012","Comment":"《三国演义》第37回，第12段","NodeType":1,"SubType":2,"X":4870,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"南阳有隐居，高眠卧不足！"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[22]}},{"Index":22,"DisplayName":"正文 013","Comment":"《三国演义》第37回，第13段","NodeType":1,"SubType":2,"X":5240,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"玄德闻歌，拉住马唤农夫问道：“此歌什么人所作？”回答说：“于是卧龙先生所作。”玄德说：“卧龙先生住哪里？”农夫说：“自此山之南，一带高冈，乃卧龙冈。冈前疏林内茅庐中，即诸葛先生高卧的地方。”玄德向他道谢，策马前行。不数里，遥望卧龙冈，果然清景异常。后人有古风一篇，单道卧龙居处。诗说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[23]}},{"Index":23,"DisplayName":"正文 014","Comment":"《三国演义》第37回，第14段","NodeType":1,"SubType":2,"X":5610,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"襄阳城西二十里，一带高冈枕流水。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[24]}},{"Index":24,"DisplayName":"正文 015","Comment":"《三国演义》第37回，第15段","NodeType":1,"SubType":2,"X":5980,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"高冈屈曲压云根，流水潺湲飞石髓。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[25]}},{"Index":25,"DisplayName":"正文 016","Comment":"《三国演义》第37回，第16段","NodeType":1,"SubType":2,"X":6350,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"势若困龙石上蟠，形如单凤松阴里。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[26]}},{"Index":26,"DisplayName":"正文 017","Comment":"《三国演义》第37回，第17段","NodeType":1,"SubType":2,"X":6720,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"柴门半掩闭茅庐，中有高人卧不起。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[27]}},{"Index":27,"DisplayName":"正文 018","Comment":"《三国演义》第37回，第18段","NodeType":1,"SubType":2,"X":7090,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"修竹交加列翠屏，四时篱落野花馨。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[28]}},{"Index":28,"DisplayName":"正文 019","Comment":"《三国演义》第37回，第19段","NodeType":1,"SubType":2,"X":7460,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"床头堆积都黄卷，座上往来无白丁。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[29]}},{"Index":29,"DisplayName":"正文 020","Comment":"《三国演义》第37回，第20段","NodeType":1,"SubType":2,"X":7830,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"叩户苍猿时献果，守门老鹤夜听经。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[30]}},{"Index":30,"DisplayName":"正文 021","Comment":"《三国演义》第37回，第21段","NodeType":1,"SubType":2,"X":8200,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"囊里名琴藏古锦，壁间宝剑映松文。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[31]}},{"Index":31,"DisplayName":"正文 022","Comment":"《三国演义》第37回，第22段","NodeType":1,"SubType":2,"X":8570,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"庐中先生独幽雅，闲来亲自勤耕稼。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[32]}},{"Index":32,"DisplayName":"正文 023","Comment":"《三国演义》第37回，第23段","NodeType":1,"SubType":2,"X":8940,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"专待春雷惊梦回，一声长啸安天下。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[33]}},{"Index":33,"DisplayName":"正文 024","Comment":"《三国演义》第37回，第24段","NodeType":1,"SubType":2,"X":9310,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"玄德来到庄前，下马亲叩柴门。一童出问，玄德说：“汉左将军宜城亭侯领豫州牧皇叔刘备，特来拜见先生。”童子说：“我记不得许多名字。”玄德说：“你只说刘备来访。”童子说：“先生今早少出。”玄德说：“哪里去了？”童子说：“踪迹不定，不知道哪里去了。”玄德说：“几时归？”童子说：“归期亦不定，或三五日，或十数日。”玄德惆怅不已。张飞说：“既不见，自归去罢了。”玄德说：“先等一会儿。”云长说：“不如且归，再使人来探听。”玄德听从了他的话，嘱付童子：“如先生回，可言刘备拜访。”于是上马。行数里，拉住马回观隆中景物，果然山不高而秀雅，水不深而澄清，地不广而平坦，林不大而茂盛，猿鹤相亲，松篁交翠，看了看不已。忽见一人，容貌轩昂，丰姿俊爽，头戴逍遥巾，身穿皂布袍，杖藜从山僻小路而来。玄德说：“这就是必卧龙先生！”急下马向前行礼，问道：“先生非卧龙否？”那人说：“将军是谁？”玄德说：“刘备。”那人说：“我非孔明，乃孔明之友，博陵崔州平。”玄德说：“久闻大名，幸得相遇。乞即席地权坐，请教一言。”二人对坐于林间石上，关、张侍立于侧。州平说：“将军为什么想要见孔明？”玄德说：“如今天下大乱，四方云扰。想要见孔明，求使国家安定之策罢了。”州平笑着说：“公以定乱为主，虽是仁心，但自古以来，治乱无常。自高祖斩蛇起义，诛无道秦，是由乱而入治；至哀、平之世二百年，太平日久，王莽篡逆，又由治而入乱；光武帝重新振兴汉朝，重整基业，复由乱而入治；至今二百年，民安已久，所以干戈又复四起。此正由治入乱之时，还不能猝定。将军想要使孔明斡旋天地，补缀乾坤，恐不易为，徒费心力罢了。难道不闻‘顺天者逸，逆天者劳’，‘数之各地，理不得而夺之；命之所定，人不得而强之’吗？”玄德说：“先生说的话，确实是高见。但备身为汉冑，合当扶助汉朝皇室，何敢委之数与命？”州平说：“山野之夫，不足与论天下事。适承明问，所以妄言之。”玄德说：“蒙先生见教。但不知道孔明往哪里去了？”州平说：“我亦想要访之，正不知道其何往。”玄德说：“请先生同至敝县，怎么样？”州平说：“愚性颇乐闲散，无意功名久了。容将来再见。”说完，长揖而去。玄德与关、张上马而行。张飞说：“孔明又访不着，却遇此腐儒，闲谈许久！”玄德说：“这就是亦隐者的话。”三人回至新野。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[34]}},{"Index":34,"DisplayName":"正文 025","Comment":"《三国演义》第37回，第25段","NodeType":1,"SubType":2,"X":9680,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"过了数日，玄德使人探听孔明。回报告说：“卧龙先生已回了。”玄德便教备马。张飞说：“量一村夫，何必哥哥自去，可使人唤来就是了。”玄德斥责道：“你难道不闻孟子云：‘想要见贤而不以其道，犹想要其入而闭的门口。’孔明当世大贤，怎么能召吗！”于是上马，再往访孔明，关、张亦乘马相随。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[35]}},{"Index":35,"DisplayName":"正文 026","Comment":"《三国演义》第37回，第26段","NodeType":1,"SubType":2,"X":10050,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"时值隆冬，天气严寒，彤云密布。行无数里，忽然朔风凛凛，瑞雪霏霏，山如玉簇，林似银妆。张飞说：“天寒地冻，尚不用兵，岂宜远见无益之人吗？不如回新野以避风雪。”玄德说：“我正想要使孔明知我殷勤的意思。如弟辈怕冷，可先回去。”飞说：“死且不怕，岂怕冷吗！但恐哥哥空劳神思。”玄德说：“不要多言，只相随同去。”将近茅庐，忽闻路旁酒店中有人作歌。玄德立马听从他。他歌说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[36]}},{"Index":36,"DisplayName":"正文 027","Comment":"《三国演义》第37回，第27段","NodeType":1,"SubType":2,"X":10420,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"壮士功名还没有成，呜呼久不遇阳春。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[37]}},{"Index":37,"DisplayName":"正文 028","Comment":"《三国演义》第37回，第28段","NodeType":1,"SubType":2,"X":10790,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"君不见东海老叟辞荆榛，后车于是与文王亲。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[38]}},{"Index":38,"DisplayName":"正文 029","Comment":"《三国演义》第37回，第29段","NodeType":1,"SubType":2,"X":11160,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"八百诸侯不期会，白鱼入舟涉孟津。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[39]}},{"Index":39,"DisplayName":"正文 030","Comment":"《三国演义》第37回，第30段","NodeType":1,"SubType":2,"X":11530,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"牧野一战血流杵，鹰扬伟烈冠武臣。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[40]}},{"Index":40,"DisplayName":"正文 031","Comment":"《三国演义》第37回，第31段","NodeType":1,"SubType":2,"X":11900,"