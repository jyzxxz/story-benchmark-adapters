List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"二人歌罢，抚掌大笑。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[52]}},{"Index":52,"DisplayName":"正文 043","Comment":"《三国演义》第37回，第43段","NodeType":1,"SubType":2,"X":16340,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"玄德说：“卧龙其在此间吗？”于是下马入店。见二人凭桌对饮，上首者白面长须，下首者清奇古貌。玄德揖而问道：“二公谁是卧龙先生？”长须者说：“公什么人？想要寻卧龙何干？”玄德说：“某乃刘备。想要访先生，求济世安民之术。”长须者说：“我们非卧龙，都卧龙之友。我是颍川石广元，此位是汝南孟公威。”玄德喜说：“备久闻二公大名，幸得邂逅。今有随行马匹在此，敢请二公同往卧龙庄上一谈。”广元说：“我们都山野慵懒之徒，不明白治理国家、安定百姓的事情，不劳下问。大人请自上马寻访卧龙。”"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[53]}},{"Index":53,"DisplayName":"正文 044","Comment":"《三国演义》第37回，第44段","NodeType":1,"SubType":2,"X":16710,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"玄德是辞二人，上马投卧龙冈来。到庄前下马，扣门问童子说：“先生今日在庄否？”童子说：“现在堂上读书。”玄德非常高兴，于是跟童子而入。至中门，只见门上大书一联云：“淡泊以明志，宁静而致远。”玄德正看间，忽闻吟咏之声，乃立于门侧窥之，见草堂之上，一少年拥炉抱膝歌说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[54]}},{"Index":54,"DisplayName":"正文 045","Comment":"《三国演义》第37回，第45段","NodeType":1,"SubType":2,"X":17080,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"凤翱翔于千仞兮，非梧不栖；"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[55]}},{"Index":55,"DisplayName":"正文 046","Comment":"《三国演义》第37回，第46段","NodeType":1,"SubType":2,"X":17450,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"士伏处于一方兮，非主不依。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[56]}},{"Index":56,"DisplayName":"正文 047","Comment":"《三国演义》第37回，第47段","NodeType":1,"SubType":2,"X":17820,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"乐躬耕于陇亩兮，我爱我庐；"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[57]}},{"Index":57,"DisplayName":"正文 048","Comment":"《三国演义》第37回，第48段","NodeType":1,"SubType":2,"X":18190,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"聊寄傲于琴书兮，以待天时。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[58]}},{"Index":58,"DisplayName":"正文 049","Comment":"《三国演义》第37回，第49段","NodeType":1,"SubType":2,"X":18560,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"玄德待其歌罢，上草堂行礼说：“备久慕先生，无缘拜会。昨因徐元直称荐，敬至仙庄，不遇空回。今特冒风雪而来，得瞻道貌，确实是万幸。”那少年慌忙答礼说：“将军难道刘豫州，想要见家兄否？”玄德惊讶，说：“先生又非卧龙吗？”少年说：“某乃卧龙的弟弟诸葛均。愚兄弟三人，长兄诸葛瑾，现在江东孙仲谋处为幕宾，孔明乃二家兄。”玄德说：“卧龙今在家否？”均说：“昨为崔州平相约，出外闲游去了。”玄德说：“哪里闲游？”均说：“或驾小舟游于江湖之中，或访僧道于山岭之上，或寻朋友于村落之间，或乐琴棋于洞府之内。往来莫测，不知道去所。”"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[59]}},{"Index":59,"DisplayName":"正文 050","Comment":"《三国演义》第37回，第50段","NodeType":1,"SubType":2,"X":18930,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"玄德说：“刘备直这样缘分浅薄，两番不遇大贤！”均说：“少坐献茶。”张飞说：“那先生既不在，请哥哥上马。”玄德说：“我既到此间，如何无一语而回？”因问诸葛均说：“闻令兄卧龙先生熟悉用兵谋略，日看兵书，可得闻吗？”均说：“不知道。”张飞说：“问他则甚！风雪甚紧，不如早归。”玄德叱阻止他。均说：“家兄不在，不敢久留车骑，容日却来回礼。”玄德说：“岂敢望先生枉驾。数日之后，备当再至。愿借纸笔作一书，留达令兄，以表刘备殷勤的意思。”均于是进文房四宝。玄德呵开冻笔，拂展云笺，写书说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[60]}},{"Index":60,"DisplayName":"正文 051","Comment":"《三国演义》第37回，第51段","NodeType":1,"SubType":2,"X":19300,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"备久慕高名，两次晋谒，不遇空回，惆怅何似！窃念备汉朝苗裔，滥叨名爵。伏睹朝廷陵替，纲纪崩摧，群雄乱国，恶党欺君，备心胆都裂。虽然有匡济之诚，实乏经纶之策。仰望先生仁慈忠诚有义气，慨然展吕望之大才，施子房之鸿略。天下非常幸运，国家非常幸运。先此布达，再容斋戒熏沐，特拜尊颜，面倾鄙悃。统希鉴原。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[61]}},{"Index":61,"DisplayName":"正文 052","Comment":"《三国演义》第37回，第52段","NodeType":1,"SubType":2,"X":19670,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"玄德写罢，递与诸葛均收了，拜辞出门。均送出，玄德再三殷勤致意而别。方上马想要行，忽见童子招手篱外，喊道：“老先生来！”玄德看他，见小桥之西，一人暖帽遮头，狐裘蔽体，骑着一驴，后随一青衣小童，携一葫芦酒，踏雪而来。转过小桥，口吟诗一首。诗说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[62]}},{"Index":62,"DisplayName":"正文 053","Comment":"《三国演义》第37回，第53段","NodeType":1,"SubType":2,"X":20040,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"一夜北风寒，万里彤云厚。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[63]}},{"Index":63,"DisplayName":"正文 054","Comment":"《三国演义》第37回，第54段","NodeType":1,"SubType":2,"X":20410,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"长空雪乱飘，改尽江山旧。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[64]}},{"Index":64,"DisplayName":"正文 055","Comment":"《三国演义》第37回，第55段","NodeType":1,"SubType":2,"X":20780,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"仰面观太虚，疑是玉龙斗。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[65]}},{"Index":65,"DisplayName":"正文 056","Comment":"《三国演义》第37回，第56段","NodeType":1,"SubType":2,"X":21150,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"纷纷鳞甲飞，一会儿遍宇宙。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[66]}},{"Index":66,"DisplayName":"正文 057","Comment":"《三国演义》第37回，第57段","NodeType":1,"SubType":2,"X":21520,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"骑驴过小桥，独叹梅花瘦。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[67]}},{"Index":67,"DisplayName":"正文 058","Comment":"《三国演义》第37回，第58段","NodeType":1,"SubType":2,"X":21890,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"玄德闻歌说：“此真卧龙了！”急忙翻身下马，向前行礼说：“先生冒寒不易！刘备等候久了！”那人慌忙下驴答礼。诸葛均在后说：“此非卧龙家兄，乃家兄岳父黄承彦。”玄德说：“适间所吟之句，极其高妙。”承彦说：“我在小婿家观《梁父吟》，记得这一篇。适过小桥，偶见篱落间梅花，所以感而诵之。不期被尊客闻。”玄德说：“曾见令婿否？”承彦说：“便是我也来看他。”玄德闻言，告别承彦，上马而归。正值风雪又大，回望卧龙冈，忧郁不快不已。后人有诗单道玄德风雪访孔明。诗说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[68]}},{"Index":68,"DisplayName":"正文 059","Comment":"《三国演义》第37回，第59段","NodeType":1,"SubType":2,"X":22260,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"一天风雪访贤良，不遇空回意感伤。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[69]}},{"Index":69,"DisplayName":"正文 060","Comment":"《三国演义》第37回，第60段","NodeType":1,"SubType":2,"X":22630,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"冻合溪桥山石滑，寒侵鞍马路途长。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[70]}},{"Index":70,"DisplayName":"正文 061","Comment":"《三国演义》第37回，第61段","NodeType":1,"SubType":2,"X"