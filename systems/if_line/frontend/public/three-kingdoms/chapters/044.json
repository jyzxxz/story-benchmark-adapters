"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[26]}},{"Index":26,"DisplayName":"正文 017","Comment":"《三国演义》第44回，第17段","NodeType":1,"SubType":2,"X":6720,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"欣群才之来萃兮，协飞熊之吉梦。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[27]}},{"Index":27,"DisplayName":"正文 018","Comment":"《三国演义》第44回，第18段","NodeType":1,"SubType":2,"X":7090,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"仰春风之和穆兮，听百鸟之悲鸣。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[28]}},{"Index":28,"DisplayName":"正文 019","Comment":"《三国演义》第44回，第19段","NodeType":1,"SubType":2,"X":7460,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"天云垣其既立兮，家愿得乎双逞。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[29]}},{"Index":29,"DisplayName":"正文 020","Comment":"《三国演义》第44回，第20段","NodeType":1,"SubType":2,"X":7830,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"扬仁化于宇宙兮，尽肃恭于上京。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[30]}},{"Index":30,"DisplayName":"正文 021","Comment":"《三国演义》第44回，第21段","NodeType":1,"SubType":2,"X":8200,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"惟桓文之为盛兮，岂足方乎圣明。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[31]}},{"Index":31,"DisplayName":"正文 022","Comment":"《三国演义》第44回，第22段","NodeType":1,"SubType":2,"X":8570,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"休矣美了！惠泽远扬。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[32]}},{"Index":32,"DisplayName":"正文 023","Comment":"《三国演义》第44回，第23段","NodeType":1,"SubType":2,"X":8940,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"翼佐我皇家兮，宁彼四方。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[33]}},{"Index":33,"DisplayName":"正文 024","Comment":"《三国演义》第44回，第24段","NodeType":1,"SubType":2,"X":9310,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"同天地之规量兮，齐日月之辉光。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[34]}},{"Index":34,"DisplayName":"正文 025","Comment":"《三国演义》第44回，第25段","NodeType":1,"SubType":2,"X":9680,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"永贵尊而无极兮，等君寿于东皇。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[35]}},{"Index":35,"DisplayName":"正文 026","Comment":"《三国演义》第44回，第26段","NodeType":1,"SubType":2,"X":10050,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"御龙旗以遨游兮，回鸾驾而周章。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[36]}},{"Index":36,"DisplayName":"正文 027","Comment":"《三国演义》第44回，第27段","NodeType":1,"SubType":2,"X":10420,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"恩化及乎四海兮，嘉物阜而民康。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[37]}},{"Index":37,"DisplayName":"正文 028","Comment":"《三国演义》第44回，第28段","NodeType":1,"SubType":2,"X":10790,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"愿斯台之永固兮，乐终古而未央。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[38]}},{"Index":38,"DisplayName":"正文 029","Comment":"《三国演义》第44回，第29段","NodeType":1,"SubType":2,"X":11160,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"周瑜听完，勃然非常生气，离座指北而骂说：“老贼欺我太甚！”孔明急起阻止他说：“昔单于屡侵疆界，汉皇帝许以公主和亲，今何惜民间二女吗？”瑜说：“公有所不知道，大乔是孙伯符将军主妇，小乔乃瑜的妻子。”孔明佯作十分害怕之状，说：“亮实不知道，失口乱言，死罪！死罪！”瑜说：“我与老贼誓不两立！”孔明说：“事须三思，免致后悔。”瑜说：“我承伯符寄托，安有屈身降操之理？适来说的话，所以相试罢了。我自离鄱阳湖，便有北伐的心思。虽然刀斧加头，不易其志。望孔明助一臂的力量，同破曹贼。”孔明说：“如果蒙不弃，愿效犬马之劳，早晚拱听驱策。”瑜说：“第二天入见主公，便议发兵。”孔明与鲁肃辞出，相别而去。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[39]}},{"Index":39,"DisplayName":"正文 030","Comment":"《三国演义》第44回，第30段","NodeType":1,"SubType":2,"X":11530,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"第二天清晨，孙权升堂。左边文官张昭、顾雍等三十余人，右边武官程普、黄盖等三十余人，衣冠济济，剑佩锵锵，分班侍立。过了一会儿，周瑜入见。礼毕，孙权问慰罢，瑜说：“近闻曹操率领军队屯汉上，快马送信至此，主公尊意怎么样？”权便取讨伐文告与周瑜看。瑜看完，笑着说：“老贼以我江东无人，敢这样相侮吗！”权说：“君之意怎么样？”瑜说：“主公曾与众文武商量否？”权说：“连日议这件事，有劝我投降的人，有劝我战者。我意未定，所以请公瑾一决。”瑜说：“谁劝主公降？”权说：“张子布等都主他的意思。”瑜便问张昭说：“愿闻先生所以主降的意思。”昭说：“曹操挟皇帝而征四方，动以朝廷为名。近又得荆州，威势愈大。我江东可以拒操者，长江罢了。今操艨艟战舰，何止千百？水陆并进，何可当之？不如且降，更图后计。”"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[40]}},{"Index":40,"DisplayName":"正文 031","Comment":"《三国演义》第44回，第31段","NodeType":1,"SubType":2,"X":11900,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"瑜说：“这就是迂儒之论！江东自开国以来，今历三世，安忍一旦废弃？”权说：“像这样，计将安出？”瑜说：“操虽托名汉相，确实是汉贼。将军以神武雄才，仗父兄余业，据有江东，兵精粮足，正当横行天下，为国家除残去暴，怎么办降贼吗？且操今此来，多犯兵家之忌。北土未平，马腾、韩遂为其后患，而操久于南征，一忌。北军不熟水战，操舍鞍马，仗舟楫，与东吴争衡，二忌。又时值隆冬盛寒，马无藁草，三忌。驱中国士兵，远涉江湖，不服水土，多生疾病，四忌。操兵犯此数忌，虽多必败。将军擒操，正在今日。瑜请得精锐士兵数万人，进屯夏口，为将军破之！”权突然起说：“老贼想要废汉自立久矣，所惧二袁、吕布、刘表与孤罢了。现在，那几个英雄都已被消灭，只剩下我还存在。孤与老贼誓不两立，卿言当伐，甚合孤意。这就是天以卿授我。”瑜说：“臣为将军决一血战，万死不辞，只恐将军狐疑不定。”权拔佩剑，斫面前奏案一角，说：“诸官将有再言降操者，与此案同！”言罢，便将此剑赐周瑜。即封瑜为大都督，程普为副都督，鲁肃为赞军校尉。如文武官将有不听号令者，即以此剑杀了他。瑜受了剑，对众说道：“我奉主公的命令，率众破曹。各位将领官员第二天都于江畔行营听从命令。如迟误者，依七禁令、五十四斩施行。”言罢，辞了孙权，起身出府。众文武各无言而散。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[41]}},{"Index":41,"DisplayName":"正文 032","Comment":"《三国演义》第44回，第32段","NodeType":1,"SubType":2,"X":12270,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"周瑜回到下处，便请孔明议事。孔明至，瑜说：“今日府下公议已定，愿求破曹良策。”孔明说：“孙将军心还没有稳，不可以决策。”瑜说：“何谓心不稳？”孔明说：“心怯曹兵之多，怀寡不敌众的意思。将军能以军数开解，使其了然无疑，然后大事可成。”瑜说：“先生之论很善。”于是又入见孙权。权说：“公瑾夜至，必有事故。”瑜说：“第二天调拨军马，主公心有疑否？”权说：“但忧曹操兵多，寡不敌众罢了。他无所疑。”瑜笑着说：“瑜特为此，特来开解主公。主公因见操讨伐文告言水陆大军百万，所以怀疑惧，不复料其虚实。今以实较之，那个将领中国的军队，不过十五六万，且已久疲。所得袁氏的人马，也止七八万耳，尚多怀疑未服。夫以久疲之卒，狐怀疑他众，其数虽多，不足畏。瑜得五万兵，自足破之。愿主公不要认为虑。”权抚瑜背说：“公瑾这句话，足释我疑。子布无谋，深失孤望。独卿及子敬与孤同心罢了。卿可与子敬、程普即日选军前进。孤当续发人马，多载资粮，为卿后应。卿前军倘不如意，便还就孤。孤当亲与操贼决战，更无他疑。”周瑜谢出，暗忖说：“孔明早已料着吴侯的心思，他的计策画又高我一头，久必为江东之患，不如杀了他。”于是命令人连夜请鲁肃入帐，言想要杀孔明的事情。肃说：“不可。今操贼未破，先杀贤士，是自去其助。”瑜说：“这个人助刘备，必为江东之患。”肃说：“诸葛瑾乃其亲兄，可令招这个人同事东吴，难道不妙呢？”瑜认为他说得好。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[42]}},{"Index":42,"DisplayName":"正文 033","Comment":"《三国演义》第44回，第33段","NodeType":1,"SubType":2,"X":12640,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"第二天天刚亮时，瑜赴行营，升中军帐高坐，左右立刀斧手，聚集文官武将听从命令。原来程普年长于瑜，今瑜爵居其上，心中不乐，这一天乃托病不出，令长子程咨自代。瑜令将领们说：“王法无亲，各位各守乃职。如今曹操把持权力，甚于董卓，囚皇帝于许昌，屯暴兵于境上。我今接受命令讨伐他们，各位幸都努力向前。大军到处，不得扰民，奖赏慰劳罚罪，并不徇纵。”令毕，即差韩当、黄盖前部先锋，领本部战船，即日起行，前至三江口扎营，别听将令；蒋钦、周泰为第二队；凌统、潘璋为第三队；太史慈、吕蒙为第四队；陆逊、董袭为第五队；吕范、朱治为四方巡警使，催督六郡官军，水陆并进，克期取齐。调拨已毕，各位将领各自收拾船只兵器起行。程咨回见父程普，说周瑜调兵，动止有法。普非常吃惊说：“我素欺周郎懦弱不足为将。今能这样，真将才！我如何不服？”于是亲自来到行营认错请罪。瑜亦逊谢。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[43]}},{"Index":43,"DisplayName":"正文 034","Comment":"《三国演义》第44回，第34段","NodeType":1,"SubType":2,"X":13010,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"第二天，瑜请诸葛瑾，对他说：“令弟孔明有王佐之才，如何屈身事刘备？今幸至江东，想要烦先生不惜齿牙余论，使令弟弃刘备而事东吴，就主公既得良辅，而先生兄弟又得相见，难道不美呢？先生幸即一行。”瑾说：“瑾自至江东，愧无寸功。今都督有命，敢不效力。”即时上马，径投驿亭来见孔明。孔明接入，哭拜，各诉阔情。瑾泣说：“弟知伯夷、叔齐吗？”孔明暗自想：“这就是必周郎教来说我。”于是回答说：“夷、齐，古之圣贤。”瑾说：“夷、齐虽至饿死首阳山下，兄弟二人亦在一处。我今与你同胞共乳，原来是各事他的主人，不能旦暮相聚。视夷、齐之为人，能无愧吗？”孔明说：“兄说的话是情；弟所守是义。弟与兄都汉人，今刘皇叔乃汉朝皇室之冑，兄若能去东吴而与弟同事刘皇叔，就上不愧为汉臣，而骨肉又得相聚，这就是情义两全之策。不识兄意觉得怎么样？”瑾思说：“我来说他，反被他说了我。”于是无言回答，起身辞去。回见周瑜，细述孔明的话。瑜说：“公意怎么样？”瑾说：“我受孙将军厚恩，安肯相背！”瑜说：“公既忠心事主，不用多言。我自有伏孔明的计策。”正是："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[44]}},{"Index":44,"DisplayName":"正文 035","Comment":"《三国演义》第44回，第35段","NodeType":1,"SubType":2,"X":13380,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"智与智逢宜必合，才和才角又不能容忍。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[45]}},{"Index":45,"DisplayName":"正文 036","Comment":"《三国演义》第44回，第36段","NodeType":1,"SubType":2,"X":13750,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"毕竟周瑜定何计伏孔明，再看下文分解。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{}}]}