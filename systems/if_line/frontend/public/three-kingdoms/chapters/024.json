{"Version":1,"StartNodeIndex":1,"Nodes":[{"Index":1,"DisplayName":"开始","Comment":"《三国演义》第24回公开阅读入口","NodeType":1,"SubType":6,"X":80,"Y":120,"Data":{},"Outputs":{"Next":[2]}},{"Index":2,"DisplayName":"章回转场","Comment":"按 VNNodeLibrary.txt 的 TransitionNode 序列化","NodeType":1,"SubType":4,"X":430,"Y":120,"Data":{"TransitionType":{"Kind":"Enum","StringValue":"FadeIn"},"BackgroundImage":{"Kind":"String","StringValue":""},"Color":{"Kind":"Color","X":0,"Y":0,"Z":0,"W":1},"Duration":{"Kind":"Float","NumberValue":0.45}},"Outputs":{"Next":[10]}},{"Index":10,"DisplayName":"正文 001","Comment":"《三国演义》第24回，第1段","NodeType":1,"SubType":2,"X":800,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说曹操见了衣带诏，与众谋士商量，想要废却献帝，更择有德者立之。程昱劝谏说：“大人所以能威震四方，号令天下是以奉汉家名号故。今诸侯未平，遽行废立的事情，必发兵端了。”操乃止。只将董承等五人并其全家全家老幼押送各门判处斩首。死者共七百余人。城宦官民见者，都下泪。后人有诗叹董承说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[11]}},{"Index":11,"DisplayName":"正文 002","Comment":"《三国演义》第24回，第2段","NodeType":1,"SubType":2,"X":1170,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"秘密诏令传衣带，天言出禁门。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[12]}},{"Index":12,"DisplayName":"正文 003","Comment":"《三国演义》第24回，第3段","NodeType":1,"SubType":2,"X":1540,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"当年曾救援皇帝，此日更承恩。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[13]}},{"Index":13,"DisplayName":"正文 004","Comment":"《三国演义》第24回，第4段","NodeType":1,"SubType":2,"X":1910,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"忧国成心疾，除奸入梦魂。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[14]}},{"Index":14,"DisplayName":"正文 005","Comment":"《三国演义》第24回，第5段","NodeType":1,"SubType":2,"X":2280,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"忠贞千古在，成败复谁论。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[15]}},{"Index":15,"DisplayName":"正文 006","Comment":"《三国演义》第24回，第6段","NodeType":1,"SubType":2,"X":2650,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"又有叹王子服等四人诗说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[16]}},{"Index":16,"DisplayName":"正文 007","Comment":"《三国演义》第24回，第7段","NodeType":1,"SubType":2,"X":3020,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"书名尺素矢忠谋，慷慨思将君父酬。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[17]}},{"Index":17,"DisplayName":"正文 008","Comment":"《三国演义》第24回，第8段","NodeType":1,"SubType":2,"X":3390,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"赤胆可怜捐百口，丹心自是足千秋。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[18]}},{"Index":18,"DisplayName":"正文 009","Comment":"《三国演义》第24回，第9段","NodeType":1,"SubType":2,"X":3760,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说曹操既杀了董承等众人，怒气未消，于是带剑入宫，来弑董贵妃。贵妃乃董承之妹，帝幸之，已怀孕五月。当天帝在后宫，正与伏皇后私论董承之事至今尚无音耗。忽见曹操带剑入宫，面有怒容，皇帝非常吃惊吓得变了脸色。操说：“董承谋反，陛下知否？”皇帝说：“董卓已诛了。”操大声说：“不是董卓，是董承。”帝战栗说：“朕实不知道。”操说：“忘了破指修诏吗？”皇帝不能答。操叱武士擒董妃至。帝告诉他说：“董妃有五月身孕，望丞相见怜！”操说：“如果不是天败，我已被害。岂得复留此女为我后患？”伏后告诉他说：“贬于冷宫，待分娩了杀了他未迟。”操说：“想要留此逆种为母报仇吗？”董妃泣告诉他说：“乞全尸而死，不要令彰露。”操令取白练至面前。帝泣谓妃说：“卿在九泉之下，不要怨朕躬。”说完，泪下如雨。伏后亦大哭。操生气地说：“犹作儿女态吗？”叱武士牵出，勒死在宫门之外。后人有诗叹董妃说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[19]}},{"Index":19,"DisplayName":"正文 010","Comment":"《三国演义》第24回，第10段","NodeType":1,"SubType":2,"X":4130,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"春殿承恩亦枉然，伤哉龙种并时捐。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[20]}},{"Index":20,"DisplayName":"正文 011","Comment":"《三国演义》第24回，第11段","NodeType":1,"SubType":2,"X":4500,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"堂堂帝主难相救，掩面徒看泪涌泉。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[21]}},{"Index":21,"DisplayName":"正文 012","Comment":"《三国演义》第24回，第12段","NodeType":1,"SubType":2,"X":4870,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"操谕监宫官说：“今后但有外戚宗族，不奉我旨，辄入宫门者，斩。防守不严，与同罪。”又拨心腹人三千充御林军，令曹洪统领，认为防察。操谓程昱说：“今董承等虽诛，还有马腾、刘备亦在此数，不可不除。”昱说：“马腾屯军西凉，还不能轻取，但当以书慰劳，不要使生疑，诱入京师图之就可以了。刘备现在徐州，分布掎角的形势，也不可轻敌。况今袁绍驻扎军队官渡，常有图许都的心思。如果我一旦东征，刘备势必求救于绍。绍趁对方空虚来袭，为什么当之？”操说：“非。备乃人杰，今若不击，待其羽翼既成，急难图了。袁绍虽强，事多怀疑不决，何足忧吗！”正商量时，郭嘉自外而入。操问道：“我想要东征刘备，奈有袁绍之忧，如何？”嘉说：“绍性迟而多疑，其谋士各相妒忌，不足忧。刘备新整军兵，众心未服，丞相率领军队东征，一战可定了。”操非常高兴说：“正合我意。”于是起大军二十万，分派军队五路下徐州。细作探知，报入徐州。孙乾先往下邳报知关公，随至小沛报知玄德。玄德与孙乾商量说：“此必求救于袁绍，才能解危。”于是玄德写信一封，遣孙乾至河北。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[22]}},{"Index":22,"DisplayName":"正文 013","Comment":"《三国演义》第24回，第13段","NodeType":1,"SubType":2,"X":5240,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"乾乃先见田丰，详细说明他的事情，求其引进。丰便引孙乾入见绍，呈上书信。只见绍形容憔悴，衣冠不整。丰说：“今日主公为什么这样？”绍说：“我将死了！”丰说：“主公何出这句话？”绍说：“我生五子，唯最幼者极快我意。今患疥疮，命已垂绝。我有何心更论他事吗？”丰说：“今曹操东征刘玄德，许昌空虚。如果以义兵趁对方空虚而入，上可以保皇帝，下可以救万民。此不易得之机会，唯大人裁之。”绍说：“我亦知此最好，奈我心中恍惚，恐有不利。”丰说：“有什么恍惚呢？”绍说：“五子中唯此子生得最异，倘有疏虞，我命休了。”于是决意不肯派兵，乃谓孙乾说：“你回见玄德，可言他的缘故。倘有不如意，可来相投，我自有相帮助他处。”田丰以杖击地说：“遭此难遇之时，乃以婴儿之病失此机会，大事去了！可痛惜呢！”跌足长叹而出。孙乾见绍不肯派兵，只得连夜回小沛见玄德，详细说明这件事。玄德非常吃惊说：“似此这该怎么办？”张飞说：“兄长不要忧。曹兵远来，必然困乏，乘其初至，先去偷袭营寨，可破曹操。”玄德说：“素以你为一勇夫耳，前者捉刘岱时，颇能使用计策，今献此策，也中用兵方法。”于是听从了他的话，分派军队偷袭营寨。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[23]}},{"Index":23,"DisplayName":"正文 014","Comment":"《三国演义》第24回，第14段","NodeType":1,"SubType":2,"X":5610,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说曹操率领军队往小沛来。正走着，狂风骤至，忽听一声响亮，将一边牙旗吹折。操便令军兵且住，聚众谋士问吉凶。荀彧说：“风从何方来？吹折甚颜色旗？”操说：“风自东南方来，吹折角上牙旗，旗乃青红二色。”彧说：“不主别事，今夜刘备必来偷袭营寨。”操点头。忽毛玠入见，说：“刚才东南风起，吹折青红牙旗一边。主公认为主何吉凶？”操说：“公意怎么样？”毛玠说：“愚意认为今夜必主有人来偷袭营寨。”后人有诗叹息说："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[24]}},{"Index":24,"DisplayName":"正文 015","Comment":"《三国演义》第24回，第15段","NodeType":1,"SubType":2,"X":5980,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"吁嗟帝冑势孤穷，全仗分派军队偷袭营寨功。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[25]}},{"Index":25,"DisplayName":"正文 016","Comment":"《三国演义》第24回，第16段","NodeType":1,"SubType":2,"X":6350,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"争奈牙旗折有兆，老天为什么纵奸雄？"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[26]}},{"Index":26,"DisplayName":"正文 017","Comment":"《三国演义》第24回，第17段","NodeType":1,"SubType":2,"X":6720,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"操说：“天报应我，当即防之。”于是分派军队九队，只留一队向前虚扎军营，其余的人马八面埋伏。当天晚上月色微明，玄德在左，张飞在右，分派军队两队进发，只留孙乾守小沛。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[27]}},{"Index":27,"DisplayName":"正文 018","Comment":"《三国演义》第24回，第18段","NodeType":1,"SubType":2,"X":7090,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说张飞自认为得计，领轻骑在前突入操寨。但见零零落落无多人马，四边火光大起，喊声齐举，飞知中了计，急出寨外。正东张辽、正西许褚、正南于禁、正北李典、东南徐晃、西南乐进、东北夏侯惇、西北夏侯渊，八处军马杀来。张飞左冲右突，前遮后当。所领军兵，原是曹操手下旧军，见事势已急，全都投降去了。飞正杀间，逢着徐晃，大杀一阵，后面乐进赶到。飞杀条血路，突围而走，只有数十骑跟定。想要还小沛，去路已断；想要投徐州、下邳，又恐曹军拦住。思考无路，只得望芒砀山而去。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[28]}},{"Index":28,"DisplayName":"正文 019","Comment":"《三国演义》第24回，第19段","NodeType":1,"SubType":2,"X":7460,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说玄德率领军队偷袭营寨，将近营寨大门，忽然喊声大震，后面冲出一军，先截去了一半人马。夏侯惇又到，玄德突围而走，夏侯渊又从后追来。玄德回顾，止有三十余骑跟随，急想要奔还小沛，早望见小沛城中火起，只得弃了小沛。想要投徐州、下邳，又见曹军漫山塞野，挡住去路。玄德心想无路可归，想袁绍有言“倘不如意，可来相投”，今不如暂往依栖，别作良图。于是望青州路而走，正逢李典拦住。玄德匹马落荒望北而逃，李典掳将从骑去了。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[29]}},{"Index":29,"DisplayName":"正文 020","Comment":"《三国演义》第24回，第20段","NodeType":1,"SubType":2,"X":7830,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说玄德匹马投青州，日行三百里，奔至青州城下叫门。门吏问了姓名，来报刺史，刺史乃袁绍长子袁谭。谭素敬玄德，得知匹马到来，即便开门出迎，接入公廨，细问他的缘故。玄德详细说明兵败相投的意思。谭乃留玄德于馆驿中住下，发书报父袁绍，一边差这个州人马，护送玄德至平原界口。袁绍亲自引众，出邺郡三十里迎接玄德。玄德行礼道谢，绍忙答礼说：“昨为小儿抱病，有失救援，于心怏怏不安。今幸得相见，大慰平生渴想之思。”玄德说：“孤穷刘备，久想要投于门下，奈机缘未遇。今被曹操攻，妻子都陷，想将军容纳四方之士，所以不避羞惭，直接过来相投，望乞收录，誓当图报。”绍非常高兴，相待非常优厚，同居冀州。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[30]}},{"Index":30,"DisplayName":"正文 021","Comment":"《三国演义》第24回，第21段","NodeType":1,"SubType":2,"X":8200,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说曹操当天晚上取了小沛，马上进军攻徐州。糜竺、简雍守把不住，只得弃城而走。陈登献了徐州。曹操大军入城。安民已毕，随唤众谋士议取下邳。荀彧说：“云长保护玄德妻子儿女死守此城，若不速取，恐被袁绍窃。”操说：“我素爱云长武艺人材，想要得之认为己用，不如令人说之使降。”郭嘉说：“云长义气深重，必不肯降。如果使人说之，恐被其害。”帐下一人出说：“某与关公有一边之交，愿往说之。”众仔细一看，原来是张辽。程昱说：“文远虽与云长有旧，我观这个人，非可以言词说。我有一计，使这个人进退无路，然后用文远说之，彼必归丞相了。”正是："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[31]}},{"Index":31,"DisplayName":"正文 022","Comment":"《三国演义》第24回，第22段","NodeType":1,"SubType":2,"X":8570,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"整备窝弓射猛虎，安排香饵钓鳌鱼。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[32]}},{"Index":32,"DisplayName":"正文 023","Comment":"《三国演义》第24回，第23段","NodeType":1,"SubType":2,"X":8940,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"未知他的计策怎么样，请看下一回。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{}}]}