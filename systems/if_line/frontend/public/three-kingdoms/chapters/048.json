,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"皎皎如月，何时可辍。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[28]}},{"Index":28,"DisplayName":"正文 019","Comment":"《三国演义》第48回，第19段","NodeType":1,"SubType":2,"X":7460,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"忧伤正从中而来，连绵不绝从未停止。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[29]}},{"Index":29,"DisplayName":"正文 020","Comment":"《三国演义》第48回，第20段","NodeType":1,"SubType":2,"X":7830,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"越过田间交错的小路，屈就了您前来拜访。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[30]}},{"Index":30,"DisplayName":"正文 021","Comment":"《三国演义》第48回，第21段","NodeType":1,"SubType":2,"X":8200,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"久别重逢，长谈畅饮，心中重温着过去的恩情。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[31]}},{"Index":31,"DisplayName":"正文 022","Comment":"《三国演义》第48回，第22段","NodeType":1,"SubType":2,"X":8570,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"月亮皎洁，星星稀疏，乌鸦向南飞去。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[32]}},{"Index":32,"DisplayName":"正文 023","Comment":"《三国演义》第48回，第23段","NodeType":1,"SubType":2,"X":8940,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"绕树三匝，无枝可依。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[33]}},{"Index":33,"DisplayName":"正文 024","Comment":"《三国演义》第48回，第24段","NodeType":1,"SubType":2,"X":9310,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"山不厌高，水不厌深。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[34]}},{"Index":34,"DisplayName":"正文 025","Comment":"《三国演义》第48回，第25段","NodeType":1,"SubType":2,"X":9680,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"我愿如周公一般礼贤下士，愿天下的英杰真心归顺于我！"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[35]}},{"Index":35,"DisplayName":"正文 026","Comment":"《三国演义》第48回，第26段","NodeType":1,"SubType":2,"X":10050,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"歌罢，众和之，共都欢笑。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[36]}},{"Index":36,"DisplayName":"正文 027","Comment":"《三国演义》第48回，第27段","NodeType":1,"SubType":2,"X":10420,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"忽座间一人进说：“大军相当之际，将士用命之时，丞相为什么出此不吉的话？”操仔细一看，原来是扬州刺史，沛国相人，姓刘名馥，字元颖。馥起自合肥，创立州治，聚逃散的百姓，立学校，广屯田，兴治教，久事曹操，多立功绩。当时操横槊问道：“我言有何不吉？”馥说：“‘月明星稀，乌鹊南飞。绕树三匝，无枝可依。’这就是不吉的话。”操非常生气地说：“你怎么敢败我兴！”手起一槊，刺死刘馥。大家都惊骇，于是罢宴。第二天，操酒醒，悔恨不已。馥子刘靖告请父尸归葬，操泣说：“我昨因醉误伤你父，后悔也来不及了，可以三公厚礼葬之。”又拨士兵护送灵柩，即日回葬。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[37]}},{"Index":37,"DisplayName":"正文 028","Comment":"《三国演义》第48回，第28段","NodeType":1,"SubType":2,"X":10790,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"第二天，水军都督毛玠、于禁诣帐下，请说：“大小船只，都已配搭连锁停当，旗帜战具，一一齐备。请丞相调遣，在约定日期进军。”操至水军中央大战船上坐定，唤集各位将领，各各听从命令。水旱二军，都分五色旗号：水军中央黄旗毛玠、于禁，前军红旗张郃，后军皂旗吕虔，左军青旗文聘，右军白旗吕通；马步前军红旗徐晃，后军皂旗李典，左军青旗乐进，右军白旗夏侯渊。水陆路都支援使夏侯惇、曹洪，护卫往来监战使许褚、张辽。他余骁将，各依队伍。令毕，水军寨中击鼓三通，各队伍战船分门而出。这一天西北风骤起，各船拽起风帆，冲波激浪，稳如平地。北军在船上踊跃施勇，刺枪使刀。前后左右，各军旗幡不杂。又有小船五十余只，往来巡警催督。操立于将台之上，观看调练，心中非常高兴，认为必胜之法。教且收住帆幔，各依次序回寨。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[38]}},{"Index":38,"DisplayName":"正文 029","Comment":"《三国演义》第48回，第29段","NodeType":1,"SubType":2,"X":11160,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"操升帐，谓众谋士说：“如果不是上天安排的命运助我，哪里能得到凤雏妙计？铁索连舟，果然渡江如履平地。”程昱说：“船都连锁，固是平稳。但彼若用火攻，难以回避，不可不防。”操大笑着说：“程仲德虽有远虑，却还有见不到处。”荀攸说：“仲德之言很，丞相为什么笑之？”操说：“凡用火攻，必借风力。如今隆冬之际，但有西风、北风，安有东风、南风吗？我居住在西北之上，那些士兵都在南岸，彼若用火，是烧自己之兵，我何惧呢？如果是十月小春之时，我早已提备了。”各位将领都跪下行礼说：“丞相高见，众人不及。”"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[39]}},{"Index":39,"DisplayName":"正文 030","Comment":"《三国演义》第48回，第30段","NodeType":1,"SubType":2,"X":11530,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"操顾各位将领说：“青、徐、燕、代的人马，不惯乘舟。今非这个计策，怎么能涉大江之险！”只见班部中二将挺身出说：“小将虽幽、燕的人，也能乘舟。今愿借巡船二十只，直至江口，夺旗鼓而还，以显北军亦能乘舟。”操仔细一看，原来是袁绍手下旧将焦触、张南。操说：“你们都生长北方，恐乘舟不便。江南的军队，往来水上，习练精熟，你不要轻以性命为儿戏。”焦触、张南大声喊道：“如其不胜，甘受军法！”操说：“战船尽已连锁，只有小舟。每舟可容二十人，只恐不方便接战。”触说：“如果用大船，没有什么奇怪的？乞付小舟二十余只，某与张南各引一半，只今日直抵江南水寨，须要夺旗斩将而还。”操说：“我与你二十只船，差拨精锐军五百人，都长枪硬弩。到第二天天明，将大寨船出到江面上，远为的形势。更差文聘亦领三十只巡船支援你回。”焦触、张南欣喜而退。第二天凌晨四更时分造饭，天快亮的五更时分结束已定，早听见水寨中击鼓敲锣收兵。船都出寨，分布水面，长江一带，青红旗号交杂。焦触、张南领哨船二十只穿寨而出，望江南进发。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[40]}},{"Index":40,"DisplayName":"正文 031","Comment":"《三国演义》第48回，第31段","NodeType":1,"SubType":2,"X":11900,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说南岸隔夜听见鼓声喧震，遥望曹操调练水军，探事有人报告知周瑜。瑜往山顶看了看，操军已收回。第二天，忽又闻鼓声震天，士兵急登高观望，见有小船冲波而来，赶快报告中军。周瑜问帐下：“谁敢先出？”韩当、周泰二人齐出说：“我当权为先锋打败敌军。”瑜喜，传令各寨严加防守，不可轻动。韩当、周泰各引哨船五只，分左右而出。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[41]}},{"Index":41,"DisplayName":"正文 032","Comment":"《三国演义》第48回，第32段","NodeType":1,"SubType":2,"X":12270,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说焦触、张南凭一勇之气，飞棹小船而来。韩当独披掩心，手执长枪，立于船头。焦触船先到，便命士兵乱箭望韩当船上射来，当用牌遮隔。焦触捻长枪与韩当交战。当手起一枪，刺死焦触。张南随后大叫赶来，隔斜里周泰船出。张南挺枪立于船头，两边弓矢乱射。周泰一臂挽牌，一手提刀。两船相离七大约一米八八，泰即飞身一跃，直跃过张南船上，手起刀落，砍张南于水中，乱杀驾舟士兵。众船飞棹急回，韩当、周泰催船追赶。到半江中，恰与文聘船相迎，两边便摆定船交战。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[42]}},{"Index":42,"DisplayName":"正文 033","Comment":"《三国演义》第48回，第33段","NodeType":1,"SubType":2,"X":12640,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"再说周瑜引将领们立于山顶，遥望江北水面。艨艟战船排合江上，旗帜号带都有次序。回看文聘与韩当、周泰相持。韩当、周泰奋力攻击，文聘抵挡不住，回船而走。韩、周二人，急催船追赶。周瑜恐二人深入重地，便将白旗招飐，令众敲锣收兵。二人乃挥棹而回。周瑜于山顶看隔江战船，尽入水寨。瑜顾谓将领们说：“江北战船如芦苇之密，操又多谋，当用何计以破之？”众未及对，忽见曹军寨中，被风吹折中央黄旗，飘入江中。瑜大笑着说：“未及破曹，先占警报罢了！”正看了看际，忽狂风大作，江中波涛拍岸。一阵风过，刮起旗角于周瑜脸上拂过。瑜猛然想起一事在心，大叫一声，往后便倒，口吐鲜血。各位将领急救起时，却早不明白人事。正是："},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[43]}},{"Index":43,"DisplayName":"正文 034","Comment":"《三国演义》第48回，第34段","NodeType":1,"SubType":2,"X":13010,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"诗赞"},"Text":{"Kind":"String","StringValue":"一时忽笑又忽叫，难使南军破北军。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{"Next":[44]}},{"Index":44,"DisplayName":"正文 035","Comment":"《三国演义》第48回，第35段","NodeType":1,"SubType":2,"X":13380,"Y":120,"Data":{"Lines":{"Kind":"List","Items":[{"Kind":"Object","ObjectValue":{"SpeakerId":{"Kind":"String","StringValue":"旁白"},"Text":{"Kind":"String","StringValue":"毕竟周瑜性命如何，再看下文分解。"},"VoiceId":{"Kind":"String","StringValue":""}}}]}},"Outputs":{}}]}