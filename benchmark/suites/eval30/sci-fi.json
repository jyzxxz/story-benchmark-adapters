    "visual_style": "冷蓝城市、红色荧光、低频能源井嗡鸣；安全区域使用较明亮的环境声。",
    "decisions": [
      {
        "id": "C1",
        "options": [
          {
            "id": "C1_A",
            "text": "关闭三号能源井"
          },
          {
            "id": "C1_B",
            "text": "先追查污染来源"
          }
        ]
      },
      {
        "id": "C2",
        "options": [
          {
            "id": "C2_A",
            "text": "相信“灯塔”的坐标"
          },
          {
